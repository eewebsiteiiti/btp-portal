# Use a strong, random secret in production
NEXTAUTH_SECRET=your-secret-here

# SQLite database file path (local file, no server needed)
DATABASE_URL="file:./dev.db"

# NextAuth URL (change for production)
NEXTAUTH_URL=http://localhost:3000

# Admin (DUGC) credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# DPGC credentials
DPGC_EMAIL=dpgc@example.com
DPGC_PASSWORD=your-dpgc-password

# Program Coordinator credentials (one per MTP domain)
PC_CSP_EMAIL=pc-csp@example.com
PC_CSP_PASSWORD=your-pc-csp-password

PC_PSPE_EMAIL=pc-pspe@example.com
PC_PSPE_PASSWORD=your-pc-pspe-password

PC_VDN_EMAIL=pc-vdn@example.com
PC_VDN_PASSWORD=your-pc-vdn-password

# Project settings
PROJECT_STUDENT_LIMIT=4

# Email settings (for sending credentials) - use Gmail App Password
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
